{# Same no-<label> constraint as fee_plans.html.twig: this renders inside
   Sylius's select_payment <label class="card-body">. #}
<div class="alma-unified-payment-button mt-3" data-alma-unified-method-code="{{ payment_method.code }}">
    <div class="alma-group" data-alma-unified-entry>
        <div class="alma-group__header" data-alma-unified-toggle role="radio" aria-checked="false" tabindex="0">
            <span class="alma-group__bullet" aria-hidden="true"></span>
            <span class="alma-group__title">{{ unified_payment_button.title }}</span>
            <img class="alma-group__logo" src="{{ asset('bundles/almasyliusplugin/images/alma-logo.svg') }}" alt="Alma" height="20">
        </div>
        {% if unified_payment_button.description %}
            <div class="alma-group__description small text-muted ps-5 pe-3 pb-3">{{ unified_payment_button.description }}</div>
        {% endif %}
    </div>
</div>

<script>
    (function () {
        var alreadyBound = window.__almaUnifiedPaymentButtonBound;
        window.__almaUnifiedPaymentButtonBound = true;

        function methodRadio(wrapper) {
            return document.querySelector(
                'input[type="radio"][name$="[method]"][value="' + wrapper.dataset.almaUnifiedMethodCode + '"]'
            );
        }

        function syncEntries() {
            document.querySelectorAll('[data-alma-unified-method-code]').forEach(function (wrapper) {
                var radio = methodRadio(wrapper);
                var selected = !!(radio && radio.checked);
                wrapper.querySelector('[data-alma-unified-entry]').classList.toggle('alma-group--active', selected);
                wrapper.querySelector('[data-alma-unified-toggle]').setAttribute('aria-checked', selected ? 'true' : 'false');
            });
        }

        function selectMethod(toggle) {
            var radio = methodRadio(toggle.closest('[data-alma-unified-method-code]'));
            if (radio && !radio.checked) {
                radio.checked = true;
                radio.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }

        if (!alreadyBound) {
            document.addEventListener('click', function (event) {
                var toggle = event.target.closest('[data-alma-unified-toggle]');
                if (toggle) {
                    event.preventDefault();
                    selectMethod(toggle);
                }
            });

            document.addEventListener('keydown', function (event) {
                var toggle = event.target.closest('[data-alma-unified-toggle]');
                if (toggle && (event.key === 'Enter' || event.key === ' ')) {
                    event.preventDefault();
                    selectMethod(toggle);
                }
            });

            document.addEventListener('change', function (event) {
                if (event.target instanceof HTMLInputElement && event.target.type === 'radio') {
                    syncEntries();
                }
            });

            document.addEventListener('DOMContentLoaded', syncEntries);

            document.addEventListener('live:connect', function (event) {
                event.detail.component.on('render:finished', syncEntries);
            });
        }

        if (document.readyState !== 'loading') {
            syncEntries();
        }
    })();
</script>
